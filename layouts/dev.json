{
  "id": "root",
  "cloned_from": {
    "name": "main-reviewer",
    "version": "herdr-devflow"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "projects",
              "type": "block",
              "content": {
                "mod": "projects"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "terminals",
              "type": "block",
              "content": {
                "mod": "terminals-list"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tabs-dev"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "work-main",
              "type": "stack",
              "active": "term",
              "children": [
                {
                  "id": "term",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "pane"
                        },
                        "reveal": "always",
                        "height": 30,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "radius": 10,
                      "gap": 8,
                      "lone": true
                    }
                  }
                },
                {
                  "id": "diff",
                  "type": "block",
                  "content": {
                    "mod": "github-diff",
                    "props": {
                      "follow": true
                    }
                  },
                  "radius": 10,
                  "border": {
                    "width": 1,
                    "color": "border"
                  }
                }
              ]
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "reviewer"
                      }
                    },
                    {
                      "id": "plan",
                      "type": "block",
                      "content": {
                        "mod": "plan-viewer"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 620
              },
              "min": 280,
              "max": 10000,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
